#!/bin/sh /etc/rc.common
# MuMuDVB service
#
# 每个启用的 'tuner' 段会被翻译成一份 mumudvb 配置文件并启动一个 procd 实例。
# 配置文件生成到 /var/etc/mumudvb/<段名>.conf（每次启动/重载重新生成）。
# 想在某个实例后面追加原始指令（new_channel、PID、模板等），
# 写 /etc/mumudvb/<段名>.conf，会被原样追加到生成的配置末尾。

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/mumudvb
RUN_DIR=/var/run/mumudvb
GEN_DIR=/var/etc/mumudvb
EXTRA_DIR=/etc/mumudvb

# 以下 UCI 选项名与 mumudvb 配置指令名一一对应，直接透传
TUNING_OPTS="card tuner delivery_system freq modulation coderate bandwidth \
	trans_mode guardinterval isdbt_layer pol srate sat_number lnb_type \
	lnb_lof_low lnb_lof_high lnb_slof switch_type switch_input pin_number \
	stream_id pls_code pls_type rolloff"

GLOBAL_OPTS="autoconfiguration autoconf_ip4 autoconf_ip6 autoconf_radios \
	autoconf_scrambled autoconf_name_template autoconf_sid_list_ignore \
	autoconf_unicast_port autoconf_multicast_port multicast_ipv4 \
	multicast_ipv6 multicast_iface4 common_port multicast_ttl \
	multicast_auto_join unicast ip_http port_http unicast_max_clients \
	unicast_queue_size hls hls_storage_dir hls_playlist_name \
	hls_rotate_time rtp_header sap sap_default_group sap_interval \
	sap_organisation rewrite_pat rewrite_sdt rewrite_eit rewrite_pmt \
	sort_eit psi_tables_filtering dvr_buffer_size dvr_thread \
	tuning_timeout timeout_no_diff check_status dont_send_scrambled \
	filter_transport_error log_type log_header"

emit() {
	local val
	config_get val "$1" "$2"
	[ -n "$val" ] && echo "$2=$val"
	return 0
}

gen_config() {
	local cfg="$1" opt extra

	echo "# generated by /etc/init.d/mumudvb from UCI section '$cfg'"
	echo "# do not edit: change /etc/config/mumudvb instead"

	for opt in $TUNING_OPTS $GLOBAL_OPTS; do
		emit "$cfg" "$opt"
	done

	extra="$EXTRA_DIR/$cfg.conf"
	if [ -f "$extra" ]; then
		echo ""
		echo "# ---- appended from $extra ----"
		cat "$extra"
	fi

	return 0
}

start_tuner() {
	local cfg="$1" enabled conf

	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" = 1 ] || return 0

	conf="$GEN_DIR/$cfg.conf"
	gen_config "$cfg" > "$conf" 2>/dev/null

	procd_open_instance "$cfg"
	procd_set_param command "$PROG" -d -c "$conf"
	procd_set_param respawn 3600 5 5
	procd_set_param file "$conf"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	local enabled custom file

	config_load mumudvb
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0

	mkdir -p "$RUN_DIR" "$GEN_DIR"

	config_get_bool custom main custom 0
	if [ "$custom" = 1 ]; then
		config_get file main custom_file "$EXTRA_DIR/mumudvb.conf"
		if [ ! -f "$file" ]; then
			logger -t mumudvb "custom config '$file' not found, not starting"
			return 1
		fi

		procd_open_instance "custom"
		procd_set_param command "$PROG" -d -c "$file"
		procd_set_param respawn 3600 5 5
		procd_set_param file "$file"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
		return 0
	fi

	config_foreach start_tuner tuner
}

service_triggers() {
	procd_add_reload_trigger "mumudvb"
}
