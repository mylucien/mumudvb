#!/bin/sh
#
# 给 mumudvb 的 HLS 输出配一个专用的 uhttpd 实例（网关）。
#
# 为什么不是简单的静态目录服务：
# 1) mumudvb 自己的 4242 只提供 /bysid/ /playlist.m3u 这些，HLS 的 .m3u8/.ts
#    只是写到 hls_storage_dir，源码里没有对应路由。
# 2) uhttpd 的 mime 表编译进二进制、没有 -m 参数、ucode/lua 插件又常被裁掉，
#    直接静态服务会给 .m3u8 回 application/octet-stream —— iOS/Safari 当文件
#    下载，不播放。
# 所以 docroot 指向只为 CGI 存在的目录，请求先 404 再经 -E 转给 cgi-bin/hls，
# 由它决定 Content-Type（细节见 hls.cgi 头部注释）。
#
# 幂等 + 可升级：用 gw_version 标记。老版本（纯静态、home=/tmp/hls）会被逐项
# 纠正过来；已经是当前版本就直接退出，不碰用户改过的端口。
#
# 注意：只挂 /etc/mumudvb/gw，不挂 /tmp —— /tmp/luci-sessions 是 LuCI 的会话
# 文件，把 /tmp 整个暴露出去等于公开后台登录态。

GW=/etc/mumudvb/gw
GW_VERSION=2

[ -f /etc/config/uhttpd ] || exit 0

[ "$(uci -q get uhttpd.mumudvb_hls.gw_version)" = "$GW_VERSION" ] && exit 0

# 段不存在就建一个；存在就沿用（保留里面的其它选项）
uci -q get uhttpd.mumudvb_hls >/dev/null || uci set uhttpd.mumudvb_hls=uhttpd

# 功能性必需项：强制对齐（老版本升级上来时 home/cgi/error_page 都是旧的）
uci set uhttpd.mumudvb_hls.home="$GW"
uci set uhttpd.mumudvb_hls.cgi_prefix='/cgi-bin'
uci set uhttpd.mumudvb_hls.error_page='/cgi-bin/hls'
uci set uhttpd.mumudvb_hls.index_page='index.html'
uci set uhttpd.mumudvb_hls.no_symlinks='1'
uci set uhttpd.mumudvb_hls.no_dirlists='1'
# -n 是并发 CGI 数，HLS 每 2 秒几片，10 够用
uci set uhttpd.mumudvb_hls.max_requests='10'

# 端口只补默认值，不覆盖用户手动改过的
uci -q get uhttpd.mumudvb_hls.listen_http >/dev/null || \
	uci set uhttpd.mumudvb_hls.listen_http='0.0.0.0:8090'

uci set uhttpd.mumudvb_hls.gw_version="$GW_VERSION"
uci commit uhttpd

# 顺带把 hls_storage_dir 补成默认值（配置里显式写过的就不动）
for s in $(uci show mumudvb 2>/dev/null | sed -n 's/^mumudvb\.\([^.=]*\)\.freq=.*/\1/p'); do
	[ -n "$(uci -q get "mumudvb.$s.hls_storage_dir")" ] || \
		uci set "mumudvb.$s.hls_storage_dir=/tmp/hls"
done
uci -q commit mumudvb

mkdir -p "$GW" /tmp/hls

logger -t mumudvb "hls gateway v$GW_VERSION configured: $GW on $(uci -q get uhttpd.mumudvb_hls.listen_http)"

exit 0
