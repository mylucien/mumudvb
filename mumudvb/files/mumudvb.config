# MuMuDVB UCI 配置
#
# 这里只是"生成配置的原料"：/etc/init.d/mumudvb 会把它翻译成真正的
# mumudvb 配置文件（每次启动/重载时生成到 /var/etc/mumudvb/<实例>.conf）。
# 需要完全手写配置时，把 main.custom 设为 1 并编辑 main.custom_file。

config mumudvb 'main'
	option enabled '0'
	# 1 = 不使用下面自动生成的配置，直接使用 custom_file 指定的文件启动单实例
	option custom '0'
	option custom_file '/etc/mumudvb/mumudvb.conf'

# 一个 tuner 段 = 一个 mumudvb 进程 = 一个 DVB 适配器上的一个前端
config tuner 'card0'
	option enabled '1'
	option name 'DVB-T1'
	option card '0'
	option tuner '0'
	option delivery_system 'DVBT'
	# 地面/有线可填 MHz（474）或 Hz（474000000），卫星填 MHz（11987）
	option freq '474'
	option bandwidth '8MHz'
	option autoconfiguration 'full'
	option autoconf_ip4 '239.100.%card.%number'
	option common_port '1234'
	option multicast_ttl '2'
	option rewrite_pat '1'
	option rewrite_sdt '1'
	# HTTP 单播：浏览器/VLC 打开 http://<路由器IP>:4242/ 即可
	option unicast '1'
	option port_http '4242'

	# HLS 输出。mumudvb 自己的 4242 端口不提供 .m3u8/.ts，切片只是写到
	# hls_storage_dir，由包里的 uhttpd 实例 mumudvb_hls（默认 8090 端口，
	# 见 /etc/config/uhttpd）对外提供，访问 http://<路由器IP>:8090/ 即可。
	# 不用 HLS 就保持 0 —— HTTP 单播已经能喂 VLC/Kodi/PotPlayer，且不落盘。
	option hls '0'
	option hls_storage_dir '/tmp/hls'
	# 每片秒数。mumudvb 默认 10 秒，一片就 10~20MB，3 个台挂在 /tmp
	# （tmpfs，吃内存）上能占 120MB 左右；2 秒能把占用压到 25MB 上下，
	# 直播延迟也从 10~20 秒降到 4~6 秒。
	option hls_rotate_time '2'
	# 播放列表里保留几片。mumudvb 默认 2（4 秒缓冲），网络一抖就卡；
	# 3 片是 6 秒缓冲，稳一点，代价是多占一片的内存。
	option hls_rotate_count '3'
